# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
  for rc in ~/.bashrc.d/*; do
    if [ -f "$rc" ]; then
      . "$rc"
    fi
  done
fi
unset rc

export TERMINAL="alacritty"
{{- if eq (get .chezmoi.osRelease "idLike") "fedora" }}

_save_cwd() {
    [[ "$PWD" != "${_cwd_last:-}" ]] && { printf '%s\n' "$PWD" > "$HOME/.cwd"; _cwd_last="$PWD"; }
}
PROMPT_COMMAND=${PROMPT_COMMAND:+$PROMPT_COMMAND;}'_save_cwd'
{{- end }}

eval "$(fzf --bash)"
eval "$(zoxide init bash)"
alias cd="z"
alias n="nvim"
alias c="code"
alias nano="micro"
{{- if eq (get .chezmoi.osRelease "idLike") "fedora" }}
alias ls="eza -l"

open() {
  nohup xdg-open "$1" >/dev/null 2>&1 &
  disown
}
{{- end }}

# opencode
export PATH={{ .chezmoi.homeDir }}/.opencode/bin:$PATH
{{- if eq (get .chezmoi.osRelease "idLike") "fedora" }}
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
{{- end }}
{{- if eq (get .chezmoi.osRelease "idLike") "debian" }}

# nvim
export PATH="$PATH:/opt/nvim/"
{{- end }}
eval "$(starship init bash)"
